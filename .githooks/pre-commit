#!/usr/bin/env bash
set -euo pipefail

echo "Pre-commit: running quality checks..."

# 1. Generate/refresh Convex types from schema and stage them.
#    convex/_generated/ is committed — keep it in sync with schema changes.
echo "  convex codegen..."
if bunx convex codegen 2>/dev/null; then
  git add convex/_generated/
else
  echo "Warning: convex codegen failed (local backend may not be running)"
  echo "  Skipping codegen — lint and typecheck will still run"
fi

# 2. Biome lint check
echo "  lint..."
bun run lint || {
  echo ""
  echo "Lint failed. Fix with: bun run lint:fix"
  exit 1
}

# 3. TypeScript type check
echo "  typecheck..."
bunx tsc --noEmit || {
  echo ""
  echo "Type check failed. Fix errors and try again."
  exit 1
}

echo "Pre-commit checks passed."
