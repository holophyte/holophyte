{
  "name": "holophyte",
  "version": "1.0.0",
  "description": "Project management for parallel Claude Code sessions",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "bun run --watch src/server.ts",
    "dev:all": "concurrently -k --kill-signal SIGINT -n server,convex -c blue,magenta 'bun run dev' 'bun run convex:dev'",
    "dev:local": "scripts/dev-local.sh",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "check": "bun run lint && bunx tsc --noEmit && bun run test",
    "convex:dev": "convex dev",
    "convex:local": "scripts/convex-local.sh",
    "convex:deploy": "convex deploy",
    "worktree:create": "scripts/worktree-create.sh",
    "pr-comments": "scripts/pr-comments.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:dev": "cd docs && bunx docusaurus start",
    "docs:build": "cd docs && bunx docusaurus build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.58.1",
    "@storybook/addon-a11y": "^10.2.8",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/react-vite": "^10.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.0.18",
    "bun-plugin-tailwind": "^0.1.2",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.41",
    "jsdom": "^28.0.0",
    "storybook": "^10.2.8",
    "tailwindcss": "^4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.90",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.31.7",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
