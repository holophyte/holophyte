{
  "name": "holophyte",
  "version": "1.0.0",
  "description": "Project management for parallel Claude Code sessions",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "bun run scripts/build.ts",
    "dev": "scripts/dev.sh",
    "dev:all": "scripts/dev-all.sh",
    "dev:local": "scripts/dev-local.sh",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "scripts/test-e2e.sh",
    "test:e2e:isolated": "scripts/test-e2e-isolated.sh",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --fix .",
    "check": "bun run lint && bunx tsc --noEmit && bun run test",
    "convex:dev": "convex dev",
    "convex:local": "scripts/convex-local.sh",
    "setup:local": "scripts/setup-local.sh",
    "seed:dev-user": "scripts/seed-dev-user.sh",
    "convex:deploy": "convex deploy",
    "worktree:create": "scripts/worktree-create.sh",
    "worktree:cleanup": "scripts/worktree-cleanup.sh",
    "pr-comments": "scripts/pr-comments.sh",
    "storybook": "storybook dev -p 6006",
    "setup": "bun run src/setup.ts",
    "setup:companion": "bun --no-env-file --env-file=.env.companion run src/setup.ts",
    "companion": "bun --no-env-file --env-file=.env.companion run src/companion.ts",
    "mcp": "bun run src/mcp/server.ts",
    "companion:preview": "scripts/companion-preview.sh",
    "build-storybook": "storybook build",
    "docs:dev": "cd docs && bunx docusaurus start",
    "docs:build": "cd docs && bunx docusaurus build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.4",
    "@storybook/addon-docs": "^10.3.4",
    "@storybook/react-vite": "^10.3.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.2",
    "bun-plugin-tailwind": "^0.1.2",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.41",
    "jsdom": "^28.1.0",
    "storybook": "^10.3.4",
    "tailwindcss": "^4.2.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.90",
    "@anthropic-ai/sdk": "^0.82.0",
    "@assistant-ui/react": "^0.12.21",
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.90",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-router": "^1.168.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.34.1",
    "lucide-react": "^0.575.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
