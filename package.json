{
  "name": "holophyte",
  "version": "1.0.0",
  "description": "An Electron app with React, TypeScript, and Bun",
  "main": "dist/main/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"bun run dev:css\" \"bun run dev:renderer\" \"bun run dev:electron\"",
    "dev:css": "tailwindcss -i ./src/renderer/styles.css -o ./src/renderer/output.css --watch",
    "dev:renderer": "bun run dev-server.ts",
    "dev:electron": "NODE_ENV=development electron .",
    "build": "bun run build:css && bun run build:main && bun run build:renderer",
    "build:css": "tailwindcss -i ./src/renderer/styles.css -o ./src/renderer/output.css --minify",
    "build:main": "bun build src/main/main.ts --outdir dist/main --target node && bun build src/main/preload.ts --outdir dist/main --target node",
    "build:renderer": "bun build src/renderer/index.html --outdir dist/renderer",
    "start": "bun run build && electron .",
    "package": "bun run build && electron-builder",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "bun run build && playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@playwright/test": "^1.58.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "concurrently": "^8",
    "electron": "^33",
    "electron-builder": "^25",
    "jsdom": "^28.0.0",
    "msw": "^2.12.8",
    "postcss": "^8.5.6",
    "tailwindcss": "3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.7",
    "electron-store": "^11.0.2",
    "lucide-react": "^0.563.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "build": {
    "appId": "com.holophyte.app",
    "productName": "Holophyte",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
