{
  "name": "holophyte",
  "version": "1.0.0",
  "description": "Project management for parallel Claude Code sessions",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "bun run scripts/build.ts",
    "dev": "scripts/dev.sh",
    "dev:all": "scripts/dev-all.sh",
    "dev:local": "scripts/dev-local.sh",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "scripts/test-e2e.sh",
    "test:e2e:worktree": "scripts/test-e2e-isolated.sh",
    "test:e2e:isolated": "scripts/test-e2e-isolated.sh",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --fix .",
    "check": "bun run lint && bunx tsc --noEmit && bun run test",
    "convex:dev": "convex dev",
    "convex:local": "scripts/convex-local.sh",
    "setup:local": "scripts/setup-local.sh",
    "seed:dev-user": "scripts/seed-dev-user.sh",
    "convex:deploy": "convex deploy",
    "worktree:create": "scripts/worktree-create.sh",
    "worktree:cleanup": "scripts/worktree-cleanup.sh",
    "pr-comments": "scripts/pr-comments.sh",
    "storybook": "storybook dev -p 6006",
    "setup": "bun run src/setup.ts",
    "setup:companion": "bun --no-env-file --env-file=.env.companion run src/setup.ts",
    "companion": "bun --no-env-file --env-file=.env.companion run src/companion.ts",
    "mcp": "bun run src/mcp/server.ts",
    "companion:preview": "scripts/companion-preview.sh",
    "build-storybook": "storybook build",
    "docs:dev": "cd docs && bunx docusaurus start",
    "docs:build": "cd docs && bunx docusaurus build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.6",
    "bun-plugin-tailwind": "^0.1.2",
    "concurrently": "^9.2.1",
    "convex-test": "0.0.52",
    "jsdom": "^29.1.1",
    "storybook": "^10.4.0",
    "tailwindcss": "^4.3.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.186",
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.92",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-router": "^1.170.4",
    "ai": "^6.0.184",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codex-app-server-client": "^0.1.5",
    "convex": "^1.39.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.38.0",
    "nanoid": "^5.1.11",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.1",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.4",
    "zustand": "^5.0.13"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "vite": "^7.3.2",
    "rollup": "^4.60.2",
    "picomatch": "^4.0.4",
    "minimatch": "^10.2.5",
    "dompurify": "^3.4.0",
    "fast-uri": "^3.1.2",
    "hono": "^4.12.19",
    "ip-address": "^10.2.0",
    "mermaid": "^11.15.0",
    "@hono/node-server": "^1.19.14",
    "postcss": "^8.5.10",
    "@anthropic-ai/sdk": "^0.96.0"
  }
}
